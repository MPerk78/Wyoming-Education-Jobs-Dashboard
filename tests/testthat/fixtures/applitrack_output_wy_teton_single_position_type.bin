document.write('&nbsp;&nbsp;<span class="normal">Jackson Hole High School</span><br/><br/></li><li><span class="label" >Date Available:</span><br/>&nbsp;&nbsp;<span class=\'normal\'>11/16/2026</span><br/><br/></li><li><span class="label" > Closing Date: </span><br/>&nbsp;&nbsp;<span class=\'normal\'>until filled</span><br/><br/></li><span>&nbsp&nbsp</span><span class="label" >Additional Information: &nbsp;</span><span class="normal"><a href="javascript:void(toggle_block(\'DescriptionText838_\'))"><u>Show/Hide</u></a></span><br/><span id=\'DescriptionText838_\' style=\'border: 1px solid black; padding:5px; display:none; opacity:.8;\'><span class="normal"><p><strong>Opening for Long&nbsp;Term Substitute for&nbsp;a Culinary Arts Teacher at Jackson Hole High School.</strong></p><p>&nbsp;</p><p>Anticipated dates of November 16th, 2026- December 17th 2026 (approximately 18 days)<br>&nbsp;</p><p><strong>Professional &nbsp;Qualifications</strong></p><ul><li data-list-item-id="e70a51a0aad0c9383e22448fa682250a3">Bachelors&nbsp;degree in Education.</li><li data-list-item-id="e493b22184f5ea227b54a4b787a551abc">Wyoming PTSB teacher certification&nbsp;with a Secondary endorsement.</li><li data-list-item-id="ea7e464040e275d58f9dc01bf1552f7e5">Applicants must be able to obtain a teaching certificate issued by the Wyoming Professional Teaching Standards Board (<a target="_blank" rel="noopener noreferrer" href="http://wyomingptsb.com/">http://wyomingptsb.com/</a>).</li><li data-list-item-id="eb6f901179b2c5118d3b96d2a2639ccaa">Substitute Permit holders may also be considered.</li></ul></span><br /><img src=\'https://www.applitrack.com/clear.gif\' height=8><br /></span><br/><div class=\'label\' align=\'right\' style=\'position:absolute; top:0%;right:1%;\'><span class=\'s\'><div class="addthis_toolbox addthis_default_style "><a class="addthis_button_preferred_1"></a><a class="addthis_button_preferred_2"></a><a class="addthis_button_preferred_3"></a><a class="addthis_button_compact"></a><a class="addthis_counter addthis_bubble_style"></a></div><script type="text/javascript" src="https://s7.addthis.com/js/250/addthis_widget.js#pubid=ra-4dfeb954767d3dc8"></script><br><a href=\'javascript:updateEmailLinkFromCurrentWindowLocation("mailto:?subject=Job Posting&body=","I thought you would be interested in an employment opportunity I found at Teton County School District #1. The position is Long Term Sub Culinary Arts Teacher. Please click the link below for more information about this vacancy.","ApplitrackHardcodedURL?1=1&AppliTrackJobId=838&AppliTrackLayoutMode=detail&AppliTrackViewPosting=1")\'><span style=\'color:#4c4c4c;font-size:.9em;font-weight:normal;\'>Email To A Friend</span></a><br/><a href=\'javascript:updateHrefFromCurrentWindowLocation("ApplitrackHardcodedURL?1=1&AppliTrackJobId=838&AppliTrackLayoutMode=detail&AppliTrackViewPosting=1" , true, false, true)\'><span style=\'color:#4c4c4c;font-size:.9em;font-weight:normal;\'>Print Version</span> </a><br/></span></div><br/></div></ul><div style=\'width: 100%; height: .75px; background: gray; overflow: hidden; margin-bottom:4px;\'></div><br /><p align=center class=noprint id=\'p835_h\'><span class=\'ListHeader\'>Openings as of 11/3/2026<br/></span></p><ul class=\'postingsList\' id=\'p835_\'><table class=\'title\' style=\'padding: 0px; width:99.2%\'><tr><td id=\'wrapword\' style=\'width: 950px; padding: 5px;\'>Long Term Sub Project Lead The Way Teacher</td><td style=\'width: 275px;\'><span class=\'title2\' style=\'float:right;text-align:right;margin-top: 8px;margin-right: 6px;\'> JobID: 835 <input type=\'button\' value=\' Apply \' onclick="applyFor(\'835\',\'Substitute\',\'Certified Substitute\')" class=\'screenOnly ApplyButton\' /></span></td></tr></table><div style=\'position:relative;\'><li><span class=\'label\'>Position Type:</span><br/>&nbsp;&nbsp;<span class=\'normal\'>Substitute/</span><span class=\'normal\'>Certified Substitute</span><br/><br/></li><li><span class="label" >Date Posted:</span><br/>');
document.write('&nbsp;&nbsp;<span class="normal">10/20/2026</span><br/><br/></li><li><span class="label" >Location:</span><br/>&nbsp;&nbsp;<span class="normal">Jackson Hole High School</span><br/><br/></li><li><span class="label" >Date Available:</span><br/>&nbsp;&nbsp;<span class=\'normal\'>12/17/2026</span><br/><br/></li><li><span class="label" > Closing Date: </span><br/>&nbsp;&nbsp;<span class=\'normal\'>until filled</span><br/><br/></li><span>&nbsp&nbsp</span><span class="label" >Additional Information: &nbsp;</span><span class="normal"><a href="javascript:void(toggle_block(\'DescriptionText835_\'))"><u>Show/Hide</u></a></span><br/><span id=\'DescriptionText835_\' style=\'border: 1px solid black; padding:5px; display:none; opacity:.8;\'><span class="normal"><p><strong>Opening for Long&nbsp;Term Substitute for&nbsp;a Project Lead The Way (PLTW) Teacher at Jackson Hole High School.</strong></p><p><a target="_blank" rel="noopener noreferrer" href="https://www.pltw.org/curriculum/pltw-engineering">PLTW</a> is a STEM focused program, and the current curriculum is based in engineering with an aviation class offering.&nbsp;</p><p>&nbsp;</p><p>Anticipated dates of December 17th, 2026&nbsp;- February 1st, 2027 (approximately 23 days)<br>&nbsp;</p><p><strong>Professional &nbsp;Qualifications</strong></p><ul><li data-list-item-id="e70a51a0aad0c9383e22448fa682250a3">Bachelors&nbsp;degree in Education, Math, Engineering or STEM related field.</li><li data-list-item-id="e493b22184f5ea227b54a4b787a551abc">Wyoming PTSB teacher certification&nbsp;with a Secondary endorsement.</li><li data-list-item-id="ea7e464040e275d58f9dc01bf1552f7e5">Applicants must be able to obtain a teaching certificate issued by the Wyoming Professional Teaching Standards Board (<a target="_blank" rel="noopener noreferrer" href="http://wyomingptsb.com/">http://wyomingptsb.com/</a>).</li><li data-list-item-id="eb6f901179b2c5118d3b96d2a2639ccaa">Substiute Permit holders may also be considered.</li></ul></span><br /><img src=\'https://www.applitrack.com/clear.gif\' height=8><br /></span><br/><div class=\'label\' align=\'right\' style=\'position:absolute; top:0%;right:1%;\'><span class=\'s\'><div class="addthis_toolbox addthis_default_style "><a class="addthis_button_preferred_1"></a><a class="addthis_button_preferred_2"></a><a class="addthis_button_preferred_3"></a><a class="addthis_button_compact"></a><a class="addthis_counter addthis_bubble_style"></a></div><script type="text/javascript" src="https://s7.addthis.com/js/250/addthis_widget.js#pubid=ra-4dfeb954767d3dc8"></script><br><a href=\'javascript:updateEmailLinkFromCurrentWindowLocation("mailto:?subject=Job Posting&body=","I thought you would be interested in an employment opportunity I found at Teton County School District #1. The position is Long Term Sub Project Lead The Way Teacher. Please click the link below for more information about this vacancy.","ApplitrackHardcodedURL?1=1&AppliTrackJobId=835&AppliTrackLayoutMode=detail&AppliTrackViewPosting=1")\'><span style=\'color:#4c4c4c;font-size:.9em;font-weight:normal;\'>Email To A Friend</span></a><br/><a href=\'javascript:updateHrefFromCurrentWindowLocation("ApplitrackHardcodedURL?1=1&AppliTrackJobId=835&AppliTrackLayoutMode=detail&AppliTrackViewPosting=1" , true, false, true)\'><span style=\'color:#4c4c4c;font-size:.9em;font-weight:normal;\'>Print Version</span> </a><br/></span></div><br/></div></ul><div style=\'width: 100%; height: .75px; background: gray; overflow: hidden; margin-bottom:4px;\'></div><br /><p align=center class=noprint id=\'p213_h\'><span class=\'ListHeader\'>Openings as of 11/3/2026<br/></span></p><ul class=\'postingsList\' id=\'p213_\'><table class=\'title\' style=\'padding: 0px; width:99.2%\'><tr><td id=\'wrapword\' style=\'width: 950px; padding: 5px;\'>Substitute Teachers/Nurses</td><td style=\'width: 275px;\'><span class=\'title2\' style=\'float:right;text-align:right;margin-top: 8px;margin-right: 6px;\'> JobID: 213 <input type=\'button\' value=\' Apply \' onclick="applyFor(\'213\',\'Substitute\',\'Certified Substitute\')" class=\'screenOnly ApplyButton\' /></span></td></tr></table><div style=\'position:relative;\'><li><span class=\'label\'>Position Type:</span><br/>&nbsp;&nbsp;<span class=\'normal\'>Substitute/</span>');
document.write('<span class=\'normal\'>Certified Substitute</span><br/><br/></li><li><span class="label" >Date Posted:</span><br/>&nbsp;&nbsp;<span class="normal">2/11/2020</span><br/><br/></li><li><span class="label" >Location:</span><br/>&nbsp;&nbsp;<span class="normal">TCSD Schools</span><br/><br/></li><span>&nbsp&nbsp</span><span class="label" >Additional Information: &nbsp;</span><span class="normal"><a href="javascript:void(toggle_block(\'DescriptionText213_\'))"><u>Show/Hide</u></a></span><br/><span id=\'DescriptionText213_\' style=\'border: 1px solid black; padding:5px; display:none; opacity:.8;\'><span class="normal"><p dir="ltr">Description: Substitute Teachers, Substitute Nurses</p>&nbsp; <p dir="ltr">Qualifications:</p>&nbsp; <ul><li aria-level="1" dir="ltr"><p dir="ltr" role="presentation">Substitute Teacher</p>&nbsp; <ul><li aria-level="2" dir="ltr"><p dir="ltr" role="presentation">Must hold a WY Teaching License or a WY Substitute Teacher License. License and permit information can be found at: <a href="http://wyomingptsb.com/">http://wyomingptsb.com/</a></p> </li> <li aria-level="2" dir="ltr"><p dir="ltr" role="presentation">WY Substitute Teacher License requires a minimum of 60 college credits.</p> </li> <li aria-level="2" dir="ltr"><p dir="ltr" role="presentation">Salary: $160.00/Whole Day, $80.00/Half Day</p> </li> </ul> </li> <li aria-level="1" dir="ltr"><p dir="ltr" role="presentation">Substitute Nurse</p>&nbsp; <ul><li aria-level="2" dir="ltr"><p dir="ltr" role="presentation">Must hold a WY Registered Nurse License or a WY School Nurse License.</p> </li> <li aria-level="2" dir="ltr"><p dir="ltr" role="presentation">Must be AED and CPR Certified.</p> </li> <li aria-level="2" dir="ltr"><p dir="ltr" role="presentation">Salary: $160.00/Whole Day, $80.00/Half Day</p> </li> </ul> </li> </ul>&nbsp; <p dir="ltr">Requirements:</p>&nbsp; <ul><li aria-level="1" dir="ltr"><p dir="ltr" role="presentation">Attend District Substitute Orientation/Training.</p> </li> <li aria-level="1" dir="ltr"><p dir="ltr" role="presentation">Complete online training tutorials as assigned.</p> </li> <li aria-level="1" dir="ltr"><p dir="ltr" role="presentation">Complete safety and security certifications, &quot;ALICE&quot;.</p> </li> <li aria-level="1" dir="ltr"><p dir="ltr" role="presentation">Ability to communicate effectively with students, and staff members, both verbally and in writing.</p> </li> <li aria-level="1" dir="ltr"><p dir="ltr" role="presentation">Must be reliable and of good moral character.</p> </li> <li aria-level="1" dir="ltr"><p dir="ltr" role="presentation">Must meet a criminal background check.</p> </li> </ul>&nbsp; <p dir="ltr">Working Conditions: Called in on an as needed basis.</p> &nbsp; <p dir="ltr">DISCLAIMER:</p>&nbsp; <p dir="ltr">This job description identifies primary responsibilities and is not intended to be a complete list of all tasks and activities. This job description is subject to change in response to student demographics, staffing factors, funding variables, modified operating procedures, and/or program/curriculum changes as directed by the Superintendent(s) or designee(s) of Teton County School District #1.</p>&nbsp; <p><br /> NOTICE OF NONDISCRIMINATION:&nbsp; The Teton County School District does not discriminate on the basis of age, sex, race, color, religion, national origin, sexual orientation, gender identity or disability in admission or access to, or treatment or employment in, its programs and activities.&nbsp; Any person having inquiries concerning the school&rsquo;s compliance with the regulations implementing the Americans with Disabilities Act (ADA) or Section 504 of the Rehabilitation Act of 1973 (Section 504) is directed to contact the Civil Rights Compliance Officer (Communications Coordinator), at the office of the School District , 307-733-2704, titleix@tcsd.org, &nbsp;or PO Box 568, 1235 Gregory Lane, Jackson, WY 83001.</p> </span><br /><img src=\'https://www.applitrack.com/clear.gif\' height=8><br /></span><br/><div class=\'label\' align=\'right\' style=\'position:absolute; top:0%;right:1%;\'><span class=\'s\'><div class="addthis_toolbox addthis_default_style "><a class="addthis_button_preferred_1"></a><a class="addthis_button_preferred_2"></a><a class="addthis_button_preferred_3"></a><a class="addthis_button_compact"></a><a class="addthis_counter addthis_bubble_style"></a></div><script type="text/javascript" src="https://s7.addthis.com/js/250/addthis_widget.js#pubid=ra-4dfeb954767d3dc8"></script><br><a href=\'javascript:updateEmailLinkFromCurrentWindowLocation("mailto:?subject=Job Posting&body=","I thought you would be interested in an employment opportunity I found at Teton County School District #1. The position is Substitute Teachers/Nurses. Please click the link below for more information about this vacancy.","ApplitrackHardcodedURL?1=1&AppliTrackJobId=213&AppliTrackLayoutMode=detail&AppliTrackViewPosting=1")\'><span style=\'color:#4c4c4c;font-size:.9em;font-weight:normal;\'>Email To A Friend</span></a><br/><a href=\'javascript:updateHrefFromCurrentWindowLocation("ApplitrackHardcodedURL?1=1&AppliTrackJobId=213&AppliTrackLayoutMode=detail&AppliTrackViewPosting=1" , true, false, true)\'><span style=\'color:#4c4c4c;font-size:.9em;font-weight:normal;\'>Print Version</span> </a><br/></span></div><br/></div></ul><div style=\'width: 100%; height: .75px; background: gray; overflow: hidden; margin-bottom:4px;\'></div><br /><p align=center class=noprint id=\'p824_h\'><span class=\'ListHeader\'>Openings as of 11/3/2026<br/></span></p><ul class=\'postingsList\' id=\'p824_\'><table class=\'title\' style=\'padding: 0px; width:99.2%\'><tr><td id=\'wrapword\' style=\'width: 950px; padding: 5px;\'>Elementary Long Term Substitute(s)</td><td style=\'width: 275px;\'><span class=\'title2\' style=\'float:right;text-align:right;margin-top: 8px;margin-right: 6px;\'> JobID: 824 <input type=\'button\' value=\' Apply \' onclick="applyFor(\'824\',\'Substitute\',\'Certified Substitute\')" class=\'screenOnly ApplyButton\' /></span></td></tr></table><div style=\'position:relative;\'><li><span class=\'label\'>Position Type:</span><br/>&nbsp;&nbsp;<span class=\'normal\'>Substitute/</span><span class=\'normal\'>Certified Substitute</span><br/><br/></li><li><span class="label" >Date Posted:</span><br/>');
document.write('&nbsp;&nbsp;<span class="normal">8/24/2026</span><br/><br/></li><li><span class="label" >Location:</span><br/>&nbsp;&nbsp;<span class="normal">TCSD Schools</span><br/><br/></li><li><span class="label" >Date Available:</span><br/>&nbsp;&nbsp;<span class=\'normal\'>09/15/2026</span><br/><br/></li><li><span class="label" > Closing Date: </span><br/>&nbsp;&nbsp;<span class=\'normal\'>until filled</span><br/><br/></li><span>&nbsp&nbsp</span><span class="label" >Additional Information: &nbsp;</span><span class="normal"><a href="javascript:void(toggle_block(\'DescriptionText824_\'))"><u>Show/Hide</u></a></span><br/><span id=\'DescriptionText824_\' style=\'border: 1px solid black; padding:5px; display:none; opacity:.8;\'><span class="normal"><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>ELEMENTARY LONG TERM SUBSTITUTE(S)</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>TCSD ELEMENTARY SCHOOLS</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>CONTRACTED PERIODS THROUGHOUT THE 2026-2027 School Year&nbsp;</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">This position is not eligible for insurance, retirement, or paid time off benefits.</span></p><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>REPORTS TO:&nbsp;</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Building administrator(s)&nbsp;</span></p><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>POSITION DESCRIPTION:&nbsp;</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Long term substitutes are needed for K-5 elementary schools. Long term substitutes will provide consistent, weekly sub coverage across K-5 schools, in all elementary grade levels. These positions will be allocated across all elementary schools including Colter Elementary, Wilson Elementary, Munger Mountain Elementary, Alta Elementary, Moran Elementary, and Kelly Elementary. Please see the included calendar as examples of scheduled dates for all school locations across the school year.&nbsp;&nbsp;&nbsp;</span></p><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>ESSENTIAL JOB FUNCTIONS:&nbsp;</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">The long term substitutes will work as a team of four substitutes to provide consistent sub coverage for a grade level teacher team in the morning while the teachers attend professional development and will provide sub coverage for another grade level teacher team in the afternoon.&nbsp;</span></p><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>Core responsibilities include:&nbsp;</strong></span></p><ul><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ee8f29b8f720dd79b166f2c2774cfa017"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Instructional Delivery: Execute pre-written lesson plans and deliver daily whole group, and small group instruction across K-5 grade levels and subjects.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="e2c2a11d74a4f00e7fba8d803fefc0a43"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Classroom &amp; Student Supervision: Maintain a safe, positive learning environment by managing student behavior and supervising students in classrooms, hallways, cafeterias, and playgrounds.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ec1edc0a6e397128751bcd57804ae7ba4"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Flexibility &amp; Coverage: Adapt to rotating assignments across various elementary schools and grade-level teams as needed for morning, afternoon, and duty coverage.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="e0aa6a81f51906f8a63f5fa36fba3437f"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Communication &amp; Feedback: Communicate with the classroom teacher regarding student progress, learning tasks, and behavioral supports, and address immediate parent inquiries when necessary.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ebb6ba744161c1008123390acce198bd8"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Safety &amp; Compliance: Follow school emergency protocols, enforce rules, and report any incidents, safety concerns, or policy violations to school administration.</span></li></ul><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>Requirements:</strong>&nbsp;</span></p><ul><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="e15998088438e52abc22ae3d1c14ed0e2"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Attend District Substitute Orientation/Training.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ef63a1484ad9f19e83d00e54dc6601ca5"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Complete online training tutorials as assigned.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ecdab3ee936fcfcf2256c2dbec60f0856"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Complete safety and security certifications, "ALICE".</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="eb5f51fa57ea8f7737d40d97445c1f5d0"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Ability to communicate effectively with students, and staff members, both verbally and in writing.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="eca152531f528c3338a7fa9aa73c93b67"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Must be reliable and of good moral character.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="eab30c3ca34735765a5dba6085a350a53"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Must meet a criminal background check.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="e27c9d67fb19c6252152ec6365f9684f3"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Flexibility with schedule changes based on substitute needs.&nbsp;</span></li></ul><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>ANTICIPATED SCHEDULING:</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">TCSD is seeking up to four long-term substitute teachers for each of the contract periods outlined below. Substitutes may choose to accept one, two, or all three contract periods based on their availability. If you accept a contract period, you must be available to work each day within that period.</span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Because substitute needs may change throughout the year, flexibility with assignments and schedules will be required. For example, if a teacher is absent or if staffing needs change, you may be reassigned to support a different classroom or grade level based on current district needs.</span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">The anticipated schedule can be found&nbsp;</span><a target="_blank" rel="noopener noreferrer" href="https://drive.google.com/file/d/1WEoe6cg5HDnHKP1deQC7skSr7nBaBoiT/view?usp=sharing"><span style="background-color:transparent;color:#1155cc;font-family:Verdana,sans-serif;font-size:10pt;"><u>here</u></span></a><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">. Color blocks are associated with the contract periods outlined below.&nbsp;</span></p><ul><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ec6528195c7639c492e0e19e75bb9882a"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>Contract Period One</strong>: September 15th, 2026 through November 19th, 2026, for a total of 33 days. *Working days are highlighted in Yellow. (Total contract would be $8,250.00)--<strong> FILLED</strong></span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ef2d6df3e062134739c38dd24b9fc3ded"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>Contract Period Two</strong>: January 5th, 2027 through March 18th, 2027, for a total of 33 days. *Working days are highlighted in Blue. (Total contract would be $8,250.00)--AVAILABLE</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="e1f45a9e1982707d3eb1e61961dadde53"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>Contract Period Three</strong>: April 6th, 2027 through May 20th, 2027, for a total of 22 days. *Working days are highlighted in Red. (Total contract would be $5,500.00)--AVAILABLE</span></li></ul><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>WAGES:</strong></span></p><ul><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ed42a1029dd70f7294dfd58c3a649e1fe"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Long Term Substitutes are paid at $250.00 per day and issued a contract.</span></li><li class="ck-list-marker-font-size ck-list-marker-font-family" style="--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="e8cde7e76373e73b060ad988be33cb66b"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">2026-2027 Compensation Package can be found&nbsp;</span><a target="_blank" rel="noopener noreferrer" href="https://drive.google.com/file/d/1VHqvcEC_yj9r8LyU76NRVc6jGJGOZtph/view?usp=drive_link"><span style="background-color:transparent;color:#1155cc;font-family:Verdana,sans-serif;font-size:10pt;"><u>here</u></span></a><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">.&nbsp;</span></li></ul><p>&nbsp;</p><p><span style="background-color:#ffffff;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>PROFESSIONAL QUALIFICATIONS:</strong></span></p><p>&nbsp;</p><ul><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="e76dd3cfaeb4da53ae6e8f8df3931e438"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">REQUIRED: Must hold a WY Substitute Teacher Permit issued by the Wyoming Professional Teaching Standards Board (https://wyomingptsb.com/)</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="ea68ea7e05d783540d0fa6c63d569d44b"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">A standard Teaching License is also acceptable with a K-6 Elementary Endorsement.</span></li><li class="ck-list-marker-font-size ck-list-marker-color ck-list-marker-font-family" style="--ck-content-list-marker-color:#000000;--ck-content-list-marker-font-family:Verdana,sans-serif;--ck-content-list-marker-font-size:10pt;" data-list-item-id="e2deb5c54d7fb72da7706f7d54c395c45"><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">Preferred experience with elementary age students.&nbsp;</span></li></ul><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>PHYSICAL DEMANDS:&nbsp;</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">The physical demands described here are representative of those that must be met by an employee to successfully perform the essential functions of this job. Reasonable accommodations may be made to enable individuals with disabilities to perform the essential functions. While performing the duties of this job, the employee is frequently required to stand and talk or hear and sometimes walk and sit on the floor depending on the age of the children. While performing the duties of this job, the employee may occasionally push or lift up to 50 lbs. 0 - 12 feet and on occasion up to 20 feet, such as boxes of books and equipment. Occasionally the employee will bend or twist at the neck more than the average person, may need to lift arms to write on chalk or marking board and occasionally stoop, kneel, crouch and reach 0 - 24 inches and up to 36 inches above the head. The employee is directly responsible for the safety, well-being and work output of other people. Specific vision abilities required by this job include close vision such as to read handwritten or typed material,the ability to adjust focus, and exposure to screen(s) via technology. Hearing ability to monitor activity and presence of students and respond to communication with students and adults is required. The position requires the individual to meet multiple demands from several people and interact with the public and other staff.&nbsp;</span></p><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>WORK ENVIRONMENT:</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">The work environment characteristics described here are representative of those an employee encounters while performing the essential functions of this job. Reasonable accommodations may be made to enable individuals with disabilities to perform the essential functions. The noise level in the work environment is normally low to moderate but may become loud when large groups are together in a room. The employee may be required to move from room to room to provide instruction and may have to maneuver in crowded hallways. Duties are typically performed indoors and occasionally outdoors, such as playground duty or when students are boarding or unloading buses. The employee may be exposed to unpredictable weather conditions. This position is typically performed in a hazard free, clean, and healthy environment.</span></p><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>DISCLAIMER:</strong></span></p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;">This job description identifies primary responsibilities and is not intended to be a complete list of all tasks and activities. This job description is subject to change in response to student demographics, staffing factors, funding variables, modified operating procedures, and/or program/curriculum changes as directed by the Superintendent(s) or designee(s) of Teton County School District #1.&nbsp;</span></p><p>&nbsp;</p><p><span style="background-color:transparent;color:#000000;font-family:Verdana,sans-serif;font-size:10pt;"><strong>NOTICE OF NONDISCRIMINATION:&nbsp;&nbsp;</strong></span></p><p><span style="background-color:#ffffff;color:#333333;font-family:Verdana,sans-serif;font-size:10pt;">The Teton County School District does not discriminate on the basis of age, sex, race, color, religion, national origin, sexual orientation, gender identity or disability in admission or access to, or treatment or employment in, its programs and activities.&nbsp; Any person having inquiries concerning the school\'s compliance with the regulations implementing the Americans with Disabilities Act (ADA) or Section 504 of the Rehabilitation Act of 1973 (Section 504) is directed to contact the Civil Rights Compliance Officer (Communications Coordinator), at the office of the School District , 307-733-2704,&nbsp;</span><a href="mailto:titleixcoordinator@tcsd.org"><span style="background-color:#ffffff;color:#1155cc;font-family:Verdana,sans-serif;font-size:10pt;"><u>titleixcoordinator@tcsd.org</u></span></a><span style="background-color:#ffffff;color:#333333;font-family:Verdana,sans-serif;font-size:10pt;"> or PO Box 568, 1235 Gregory Lane, Jackson, WY 83001.</span></p><p>&nbsp;</p></span><br /><img src=\'https://www.applitrack.com/clear.gif\' height=8><br /></span><br/><div class=\'label\' align=\'right\' style=\'position:absolute; top:0%;right:1%;\'><span class=\'s\'><div class="addthis_toolbox addthis_default_style "><a class="addthis_button_preferred_1"></a><a class="addthis_button_preferred_2"></a><a class="addthis_button_preferred_3"></a><a class="addthis_button_compact"></a><a class="addthis_counter addthis_bubble_style"></a></div><script type="text/javascript" src="https://s7.addthis.com/js/250/addthis_widget.js#pubid=ra-4dfeb954767d3dc8"></script><br><a href=\'javascript:updateEmailLinkFromCurrentWindowLocation("mailto:?subject=Job Posting&body=","I thought you would be interested in an employment opportunity I found at Teton County School District #1. The position is Elementary Long Term Substitute(s). Please click the link below for more information about this vacancy.","ApplitrackHardcodedURL?1=1&AppliTrackJobId=824&AppliTrackLayoutMode=detail&AppliTrackViewPosting=1")\'><span style=\'color:#4c4c4c;font-size:.9em;font-weight:normal;\'>Email To A Friend</span></a><br/><a href=\'javascript:updateHrefFromCurrentWindowLocation("ApplitrackHardcodedURL?1=1&AppliTrackJobId=824&AppliTrackLayoutMode=detail&AppliTrackViewPosting=1" , true, false, true)\'><span style=\'color:#4c4c4c;font-size:.9em;font-weight:normal;\'>Print Version</span> </a><br/></span></div><br/></div></ul><div style=\'width: 100%; height: .75px; background: gray; overflow: hidden; margin-bottom:4px;\'></div><br /><p align=center class=noprint id=\'p214_h\'><span class=\'ListHeader\'>Openings as of 11/3/2026<br/></span></p><ul class=\'postingsList\' id=\'p214_\'><table class=\'title\' style=\'padding: 0px; width:99.2%\'><tr><td id=\'wrapword\' style=\'width: 950px; padding: 5px;\'>Substitute Para/Secretary</td><td style=\'width: 275px;\'><span class=\'title2\' style=\'float:right;text-align:right;margin-top: 8px;margin-right: 6px;\'> JobID: 214 <input type=\'button\' value=\' Apply \' onclick="applyFor(\'214\',\'Substitute\',\'Non Certified Substitute\')" class=\'screenOnly ApplyButton\' /></span></td></tr></table><div style=\'position:relative;\'><li><span class=\'label\'>Position Type:</span><br/>&nbsp;&nbsp;<span class=\'normal\'>Substitute/</span>');
